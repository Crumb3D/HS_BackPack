<configs>
	<setattribute xpath="/windows/window[@name='windowBackpack']" name="width">596</setattribute>
	<setattribute xpath="/windows/window[@name='windowBackpack']" name="height">447</setattribute>
	<remove xpath="/windows/window[@name='windowBackpack']/rect[@name='content']"/>
	<insertAfter xpath="/windows/window[@name='windowBackpack']/rect[@name='header']">
		<rect name="content" height="371" depth="0" pos="0,-46">
			<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" pos="0,0" width="596" height="371" color="[black]" type="sliced" fillcenter="false" on_press="true" snap="false" gamepad_selectable="false"/>
			<grid depth="10" name="inventory" rows="5" cols="8" pos="3,-3" cell_width="73" cell_height="73" controller="Backpack" repeat_content="true">
				<item_stack name="0" cell_size="73"/>
			</grid>
		</rect>
	</insertAfter>
	<append xpath="/windows/window[@name='windowBackpack']/rect[@name='header']">
		<pager name="pager" pos="175,-6" width="110" height="32" contents_parent="content" show_max_page="true" separator=" / "/>
	</append>

	<conditional>
		<if cond="game_version() &lt; version(1, 3, 30)">
			<insertAfter xpath="/windows/window[@name='CharacterFrameWindow']//rect[@controller='TabSelectorTab' and @tab_key='clothing']">
				<rect controller="TabSelectorTab" tab_key="backpack" tab_caption_key="lblCategoryBackpack" tab_sprite="ui_game_symbol_backpack">
					<rect>
						<grid name="backpackSlots" rows="1" cols="1" cell_width="81" cell_height="70">
							<equipment_stack_sdcs slot="Backpack" empty_sprite="cntBackpack03" empty_tooltip="lblBackpack" />
						</grid>
					</rect>
				</rect>
			</insertAfter>
		</if>
	</conditional>
</configs>
