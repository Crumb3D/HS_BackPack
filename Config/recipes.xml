<configs>
	<conditional>
		<if cond="game_version() &lt; version(1, 3, 30)">
			<append xpath="/recipes">
				<recipe name="backpackSmall" count="1" craft_area="workbench" craft_time="10" tags="learnable,workbenchCrafting">
					<ingredient name="resourceSewingKit" count="1"/>
					<ingredient name="resourceCloth" count="5"/>
					<ingredient name="resourceForgedIron" count="0"/>
					<effect_group>
						<passive_effect name="CraftingIngredientCount" level="2,3,4,5,6" operation="base_add" value="1,2,3,4,5" tags="resourceSewingKit"/>
						<passive_effect name="CraftingIngredientCount" level="2,3,4,5,6" operation="base_add" value="5,10,15,20,20" tags="resourceCloth"/>
						<passive_effect name="CraftingIngredientCount" level="4,5,6" operation="base_add" value="1,3,5" tags="resourceForgedIron"/>
					</effect_group>
				</recipe>
				<recipe name="backpackMedium" count="1" craft_area="workbench" craft_time="30" tags="learnable,workbenchCrafting">
					<ingredient name="resourceSewingKit" count="7"/>
					<ingredient name="resourceLeather" count="25"/>
					<ingredient name="resourceForgedIron" count="5"/>
					<effect_group>
						<passive_effect name="CraftingIngredientCount" level="2,3,4,5,6" operation="base_add" value="1,2,3,4,5" tags="resourceSewingKit"/>
						<passive_effect name="CraftingIngredientCount" level="2,3,4,5,6" operation="base_add" value="5,10,15,20,25" tags="resourceLeather"/>
						<passive_effect name="CraftingIngredientCount" level="2,3,4,5,6" operation="base_add" value="5,10,15,20,25" tags="resourceForgedIron"/>
					</effect_group>
				</recipe>
				<recipe name="backpackLarge" count="1" craft_area="workbench" craft_time="60" tags="learnable,workbenchCrafting">
					<ingredient name="resourceSewingKit" count="13"/>
					<ingredient name="resourceLeather" count="50"/>
					<ingredient name="resourceScrapPolymers" count="20"/>
					<ingredient name="resourceForgedSteel" count="5"/>
					<ingredient name="resourceLegendaryParts" count="0"/>
					<effect_group>
						<passive_effect name="CraftingIngredientCount" level="2,3,4,5,6" operation="base_add" value="1,2,3,4,5" tags="resourceSewingKit"/>
						<passive_effect name="CraftingIngredientCount" level="2,3,4,5,6" operation="base_add" value="5,10,15,20,25" tags="resourceLeather"/>
						<passive_effect name="CraftingIngredientCount" level="2,3,4,5,6" operation="base_add" value="15,30,45,60,75" tags="resourceScrapPolymers"/>
						<passive_effect name="CraftingIngredientCount" level="2,3,4,5,6" operation="base_add" value="5,10,15,20,25" tags="resourceForgedSteel"/>
						<passive_effect name="CraftingIngredientCount" level="6" operation="base_add" value="1" tags="resourceLegendaryParts"/>
					</effect_group>
				</recipe>
			</append>
		</if>
	</conditional>
</configs>
